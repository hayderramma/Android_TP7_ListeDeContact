# Copier ce fichier vers "local.properties" (fichier ignore par Git).
# Renseigner votre propre cle API Google Maps : elle ne doit jamais etre versionnee.
# Sous Windows, Gradle accepte aussi les chemins avec "/" :
# sdk.dir=C:/Users/Vous/AppData/Local/Android/Sdk
sdk.dir=/chemin/vers/Android/Sdk
MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
